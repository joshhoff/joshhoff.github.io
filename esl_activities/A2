        <!-- Main Content -->
        <main class="container mx-auto px-4 md:px-8 py-8">
            <!-- Introduction -->
            <section class="mb-12 text-center">
                <h2 class="text-2xl md:text-3xl font-bold text-gray-800 mb-4">Time Prepositions with Drone Technology</h2>
                <p class="text-gray-600 max-w-3xl mx-auto">Learn when to use <span class="font-semibold">in</span>, <span class="font-semibold">at</span>, and <span class="font-semibold">on</span> when talking about time in drone-related contexts.</p>
                
                <div class="mt-6 bg-white p-5 rounded-xl shadow-md max-w-3xl mx-auto">
                    <h3 class="text-lg font-bold text-purple-700 mb-3">Time Preposition Rules:</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-left">
                        <div class="p-3 bg-purple-50 rounded-lg">
                            <h4 class="font-bold text-purple-800">IN</h4>
                            <ul class="mt-2 space-y-1 text-sm">
                                <li>• Months: <span class="time-highlight">in May</span></li>
                                <li>• Seasons: <span class="time-highlight">in summer</span></li>
                                <li>• Years: <span class="time-highlight">in 2023</span></li>
                                <li>• Parts of day: <span class="time-highlight">in the morning</span></li>
                                <li>• Time periods: <span class="time-highlight">in 5 minutes</span></li>
                            </ul>
                        </div>
                        <div class="p-3 bg-indigo-50 rounded-lg">
                            <h4 class="font-bold text-indigo-800">AT</h4>
                            <ul class="mt-2 space-y-1 text-sm">
                                <li>• Specific times: <span class="time-highlight">at 3 o'clock</span></li>
                                <li>• Precise moments: <span class="time-highlight">at noon</span></li>
                                <li>• Holidays: <span class="time-highlight">at Christmas</span></li>
                                <li>• Night: <span class="time-highlight">at night</span></li>
                                <li>• Weekend: <span class="time-highlight">at the weekend</span> (UK)</li>
                            </ul>
                        </div>
                        <div class="p-3 bg-blue-50 rounded-lg">
                            <h4 class="font-bold text-blue-800">ON</h4>
                            <ul class="mt-2 space-y-1 text-sm">
                                <li>• Days: <span class="time-highlight">on Monday</span></li>
                                <li>• Dates: <span class="time-highlight">on May 5th</span></li>
                                <li>• Specific day parts: <span class="time-highlight">on Friday morning</span></li>
                                <li>• Special days: <span class="time-highlight">on my birthday</span></li>
                                <li>• Weekend: <span class="time-highlight">on the weekend</span> (US)</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Activities Navigation -->
            <nav class="mb-12">
                <ul class="flex flex-wrap justify-center gap-4">
                    <li><button onclick="showSection('fill-blanks')" class="btn-primary bg-purple-600 hover:bg-purple-700 text-white px-5 py-2 rounded-lg">Fill in the Blanks</button></li>
