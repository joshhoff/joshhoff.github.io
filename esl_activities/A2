        }
        
        .btn-secondary {
            transition: all 0.3s ease;
        }
        
        .btn-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }
        
        .time-highlight {
            background-color: #fef3c7;
            padding: 0 3px;
            border-radius: 3px;
        }
