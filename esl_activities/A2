                    <li><button onclick="showSection('conversation')" class="btn-primary bg-purple-600 hover:bg-purple-700 text-white px-5 py-2 rounded-lg">Conversation Practice</button></li>
                    <li><button onclick="showSection('time-expressions')" class="btn-primary bg-purple-600 hover:bg-purple-700 text-white px-5 py-2 rounded-lg">Time Expressions</button></li>
                </ul>
            </nav>

            <!-- Activity Sections -->
            <div id="activity-container">
                <!-- Fill in the Blanks -->
                <section id="fill-blanks" class="activity-section bg-white rounded-xl p-6 shadow-lg mb-12">
                    <h3 class="text-xl font-bold text-gray-800 mb-6">Fill in the Blanks with in, at, or on</h3>
                    
                    <div class="space-y-6">
                        <div class="fill-blank-question p-4 border border-gray-200 rounded-lg">
                            <p class="mb-3">The drone delivery will arrive <select class="border rounded px-2 py-1" data-answer="at">
                                <option value="">Choose</option>
                                <option value="in">in</option>
                                <option value="at">at</option>
                                <option value="on">on</option>
                            </select> 3:30 PM tomorrow.</p>
                            <div class="feedback hidden"></div>
                        </div>
                        
                        <div class="fill-blank-question p-4 border border-gray-200 rounded-lg">
                            <p class="mb-3">We schedule drone inspections <select class="border rounded px-2 py-1" data-answer="on">
                                <option value="">Choose</option>
                                <option value="in">in</option>
                                <option value="at">at</option>
                                <option value="on">on</option>
                            </select> Mondays and Wednesdays.</p>
                            <div class="feedback hidden"></div>
                        </div>
                        
                        <div class="fill-blank-question p-4 border border-gray-200 rounded-lg">
                            <p class="mb-3">The drone battery will be fully charged <select class="border rounded px-2 py-1" data-answer="in">
                                <option value="">Choose</option>
                                <option value="in">in</option>
                                <option value="at">at</option>
                                <option value="on">on</option>
                            </select> 30 minutes.</p>
