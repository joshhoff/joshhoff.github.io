                    feedbackDiv.className = 'writing-feedback text-yellow-600';
                } else {
                    feedbackDiv.textContent = 'Remember to use in, at, or on in your sentence.';
                    feedbackDiv.className = 'writing-feedback text-yellow-600';
                }
            });
        });

        // Show Conversation Answers
        document.querySelectorAll('.show-conversation-answers').forEach(button => {
            button.addEventListener('click', function() {
                const answersDiv = this.closest('.conversation-card').querySelector('.conversation-answers');
                answersDiv.classList.toggle('hidden');
                
                if (answersDiv.classList.contains('hidden')) {
                    this.textContent = 'Show Answers';
                } else {
                    this.textContent = 'Hide Answers';
                }
            });
        });

        // Time Expressions Check
        document.getElementById('check-time-expressions').addEventListener('click', function() {
            const selects = document.querySelectorAll('#time-expressions select');
            const feedbackDiv = document.getElementById('time-expressions-feedback');
            let correctCount = 0;
            let totalCount = selects.length;
            
            selects.forEach(select => {
                const selectedValue = select.value;
                const correctValue = select.getAttribute('data-answer');
                
                if (selectedValue === correctValue) {
                    select.classList.add('bg-green-100', 'border-green-300');
                    correctCount++;
                } else {
                    select.classList.add('bg-red-100', 'border-red-300');
                }
            });
            
            feedbackDiv.classList.remove('hidden');
            
            if (correctCount === totalCount) {
                feedbackDiv.textContent = `Perfect! You got all ${correctCount} answers correct!`;
                feedbackDiv.className = 'mt-3 text-green-600 font-medium';
            } else {
                feedbackDiv.textContent = `You got ${correctCount} out of ${totalCount} correct. Try again!`;
                feedbackDiv.className = 'mt-3 text-yellow-600 font-medium';
            }
        });

        // Final Challenge Check
        document.getElementById('check-final-challenge').addEventListener('click', function() {
            const inputs = document.querySelectorAll('.time-answer');
            const feedbackDiv = document.getElementById('final-challenge-feedback');
            let correctCount = 0;
            let totalCount = inputs.length;
            
            inputs.forEach(input => {
                const enteredValue = input.value.toLowerCase().trim();
                const correctValue = input.getAttribute('data-answer');
                
                if (enteredValue === correctValue) {
                    input.classList.add('bg-green-100', 'border-green-300');
                    correctCount++;
                } else {
                    input.classList.add('bg-red-100', 'border-red-300');
                }
            });
            
            feedbackDiv.classList.remove('hidden');
            
            if (correctCount === totalCount) {
                feedbackDiv.innerHTML = `<span class="text-green-600 font-medium">Excellent! You completed the schedule perfectly!</span><br><span class="text-purple-600">You've mastered using time prepositions with drone technology vocabulary.</span>`;
            } else {
                feedbackDiv.innerHTML = `<span class="text-yellow-600 font-medium">You got ${correctCount} out of ${totalCount} correct.</span><br><span class="text-purple-600">Review the time preposition rules and try again!</span>`;
            }
        });

        // Initialize the first section as visible
        showSection('fill-blanks');
    </script>
